# Copy this file to .env and fill in the values. Never commit the real .env.

# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/feriaApp
# Separate database for the test suite (tests run deleteMany; never point at the real DB)
MONGODB_TEST_URI=mongodb://localhost:27017/feriaApp_test

# Auth
JWT_SECRET=change_me

# GitHub publishing (public web -> gh-pages)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# AI caseta detection (Claude vision). Get a key at https://console.anthropic.com
# Without it, the map detection endpoint returns a 503.
ANTHROPIC_API_KEY=

# Optional: AI detection timeout (ms)
# AI_DETECT_TIMEOUT_MS=180000
